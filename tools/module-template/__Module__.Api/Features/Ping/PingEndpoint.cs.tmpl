using Laundry.BuildingBlocks.Api;
using Laundry.__Module__.Application.Features.Ping;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Routing;

namespace Laundry.__Module__.Api.Features.Ping;

public sealed class PingEndpoint : IEndpoint
{
    public void MapEndpoint(IEndpointRouteBuilder app) =>
        app.MapGet("/__module__/ping", HandleAsync)
            .AllowAnonymous()
            .WithTags("__Module__")
            .WithName("__Module__Ping");

    private static async Task<IResult> HandleAsync(PingHandler handler, CancellationToken cancellationToken)
    {
        var result = await handler.HandleAsync(cancellationToken);

        return Results.Ok(result.Value);
    }
}
