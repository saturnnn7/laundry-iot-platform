# Copy to infra/compose/.env and replace every CHANGE_ME value.
# Generation commands are in infra/README.md.

POSTGRES_DB=laundry
POSTGRES_USER=laundry
POSTGRES_PASSWORD=CHANGE_ME_hex_string

# Public host name served by Caddy. localhost uses Caddy's internal certificate.
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
MQTT_PORT=8883

# Used by backend.compose.yml only.
JWT_SIGNING_KEY=CHANGE_ME_hex_string_at_least_64_chars
BACKEND_IMAGE=registry.example.com/laundry-backend:CHANGE_ME
